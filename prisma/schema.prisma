generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                 @id @default(cuid())
  email                String                 @unique
  name                 String
  passwordHash         String
  role                 Role
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  invitationsIssued    AccountInvitation[]    @relation("InvitationIssuedBy")
  assignedApplications AdmissionApplication[] @relation("AssignedOfficer")
  reviews              AdmissionReview[]
  auditLogs            AuditLog[]
}

model AccountInvitation {
  id          String    @id @default(cuid())
  email       String
  role        Role
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  createdBy   User?     @relation("InvitationIssuedBy", fields: [createdById], references: [id])
}

model Notice {
  id          String    @id @default(cuid())
  titleEn     String
  titleBn     String
  bodyEn      String
  bodyBn      String
  isImportant Boolean   @default(false)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Achievement {
  id            String   @id @default(cuid())
  titleEn       String
  titleBn       String
  descriptionEn String
  descriptionBn String
  year          Int
  category      String
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Club {
  id            String   @id @default(cuid())
  nameEn        String
  nameBn        String
  descriptionEn String
  descriptionBn String
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Facility {
  id            String   @id @default(cuid())
  titleEn       String
  titleBn       String
  descriptionEn String
  descriptionBn String
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AlumniMessage {
  id             String   @id @default(cuid())
  nameEn         String
  nameBn         String
  messageEn      String
  messageBn      String
  graduationYear Int?
  roleEn         String?
  roleBn         String?
  organizationEn String?
  organizationBn String?
  photoUrl       String?
  isFeatured     Boolean  @default(false)
  isPublished    Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  previewEn      String?
  previewBn      String?
  sscBatch       String?
  hscBatch       String?
}

model Career {
  id            String              @id @default(cuid())
  titleEn       String
  titleBn       String
  descriptionEn String
  descriptionBn String              @db.Text
  summaryEn     String?             @db.Text
  summaryBn     String?             @db.Text
  categoryEn    String?
  categoryBn    String?
  imageData     String?             @db.Text
  deadline      DateTime?
  isPublished   Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  applications  CareerApplication[] @relation("CareerApplications")
}

model CareerApplication {
  id            String   @id @default(cuid())
  careerId      String
  fullName      String
  email         String
  phone         String
  qualification String?
  experience    String?
  coverLetter   String?
  createdAt     DateTime @default(now())
  career        Career   @relation("CareerApplications", fields: [careerId], references: [id], onDelete: Cascade)

  @@index([careerId])
  @@index([createdAt])
}

model AdmissionCycle {
  id           String                 @id @default(cuid())
  nameEn       String
  nameBn       String
  opensAt      DateTime
  closesAt     DateTime
  updatedAt    DateTime               @updatedAt
  createdAt    DateTime               @default(now())
  applications AdmissionApplication[]
}

model AdmissionApplication {
  id                  String              @id @default(cuid())
  cycleId             String
  status              ApplicationStatus   @default(UNASSIGNED)
  fullName            String
  dateOfBirth         DateTime
  gender              String
  applyingClass       String
  previousInstitution String
  presentAddress      String
  permanentAddress    String
  assignedOfficerId   String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  nationality         String
  medium              String
  birthRegistrationNo String
  certificateName     String?
  certificateMimeType String?
  certificateData     Bytes?
  fatherName          String
  fatherNidNumber     String
  fatherContactNumber String
  fatherOccupation    String
  fatherNationality   String
  fatherIsAlive       Boolean
  motherName          String
  motherNidNumber     String
  motherContactNumber String
  motherOccupation    String
  motherNationality   String
  motherIsAlive       Boolean
  assignedOfficer     User?               @relation("AssignedOfficer", fields: [assignedOfficerId], references: [id])
  cycle               AdmissionCycle      @relation(fields: [cycleId], references: [id])
  guardians           AdmissionGuardian[]
  reviews             AdmissionReview[]
}

model AdmissionGuardian {
  id            String               @id @default(cuid())
  applicationId String
  name          String
  relationship  String
  nidNumber     String
  contactNumber String
  occupation    String
  nationality   String
  isAlive       Boolean
  createdAt     DateTime             @default(now())
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model AdmissionReview {
  id               String               @id @default(cuid())
  applicationId    String
  officerId        String?
  internalNote     String
  applicantMessage String?
  statusAtReview   ApplicationStatus
  createdAt        DateTime             @default(now())
  application      AdmissionApplication @relation(fields: [applicationId], references: [id])
  officer          User?                @relation(fields: [officerId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  actorLabel String
  action     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  ADMISSION_OFFICER
}

enum ApplicationStatus {
  UNASSIGNED
  ASSIGNED
  UNDER_REVIEW
  AWAITING_APPLICANT
  ELIGIBLE
  NOT_ELIGIBLE
  EXAM_ELIGIBLE
  EXAM_COMPLETED
  FINAL_DECISION
}


model HelpArticle {
  id          String   @id @default(cuid())
  slug        String   @unique
  questionEn  String
  questionBn  String
  answerEn    String   @db.Text
  answerBn    String   @db.Text
  categoryEn  String
  categoryBn  String
  isPublished Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
  @@index([categoryEn])
}
