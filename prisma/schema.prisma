generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                 @id @default(cuid())
  email                String                 @unique
  name                 String
  passwordHash         String
  role                 Role
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  invitationsIssued    AccountInvitation[]    @relation("InvitationIssuedBy")
  assignedApplications AdmissionApplication[] @relation("AssignedOfficer")
  reviews              AdmissionReview[]
  bloggerProfile       BloggerProfile?
  teacherProfile       TeacherProfile?
  reviewedBlogApplications BlogApplication[] @relation("BlogApplicationReviewer")
  reviewedNameChanges  BloggerNameChange[] @relation("NameChangeReviewer")
  auditLogs            AuditLog[]
}

model AccountInvitation {
  id          String    @id @default(cuid())
  email       String
  role        Role
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  createdBy   User?     @relation("InvitationIssuedBy", fields: [createdById], references: [id])
}

model Notice {
  id          String    @id @default(cuid())
  titleEn     String
  titleBn     String
  bodyEn      String
  bodyBn      String
  isImportant Boolean   @default(false)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Event {
  id             String   @id @default(cuid())
  titleEn        String
  titleBn        String
  summaryEn      String
  summaryBn      String
  descriptionEn  String   @db.Text
  descriptionBn  String   @db.Text
  coverImage     String?  @db.Text
  photoUrls      String?  @db.Text
  venueEn        String?
  venueBn        String?
  startAt        DateTime
  endAt          DateTime?
  isPublished    Boolean  @default(false)
  isFeatured     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isPublished, startAt])
}

model Achievement {
  id            String   @id @default(cuid())
  titleEn       String
  titleBn       String
  descriptionEn String
  descriptionBn String
  year          Int
  category      String
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Club {
  id            String   @id @default(cuid())
  nameEn        String
  nameBn        String
  descriptionEn String
  descriptionBn String
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Facility {
  id            String   @id @default(cuid())
  titleEn       String
  titleBn       String
  descriptionEn String
  descriptionBn String
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AlumniMessage {
  id             String   @id @default(cuid())
  nameEn         String
  nameBn         String
  messageEn      String
  messageBn      String
  graduationYear Int?
  roleEn         String?
  roleBn         String?
  organizationEn String?
  organizationBn String?
  photoUrl       String?
  isFeatured     Boolean  @default(false)
  isPublished    Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  previewEn      String?
  previewBn      String?
  sscBatch       String?
  hscBatch       String?
}

model Career {
  id            String              @id @default(cuid())
  titleEn       String
  titleBn       String
  descriptionEn String
  descriptionBn String              @db.Text
  summaryEn     String?             @db.Text
  summaryBn     String?             @db.Text
  categoryEn    String?
  categoryBn    String?
  imageData     String?             @db.Text
  deadline      DateTime?
  isPublished   Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  applications  CareerApplication[] @relation("CareerApplications")
}

model CareerApplication {
  id            String   @id @default(cuid())
  careerId      String
  fullName      String
  email         String
  phone         String
  qualification String?
  experience    String?
  coverLetter   String?
  createdAt     DateTime @default(now())
  career        Career   @relation("CareerApplications", fields: [careerId], references: [id], onDelete: Cascade)

  @@index([careerId])
  @@index([createdAt])
}

model AdmissionCycle {
  id           String                 @id @default(cuid())
  nameEn       String
  nameBn       String
  opensAt      DateTime
  closesAt     DateTime
  updatedAt    DateTime               @updatedAt
  createdAt    DateTime               @default(now())
  applications AdmissionApplication[]
}

model AdmissionApplication {
  id                  String              @id @default(cuid())
  cycleId             String
  status              ApplicationStatus   @default(UNASSIGNED)
  fullName            String
  dateOfBirth         DateTime
  gender              String
  applyingClass       String
  previousInstitution String
  presentAddress      String
  permanentAddress    String
  assignedOfficerId   String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  nationality         String
  medium              String
  birthRegistrationNo String
  certificateName     String?
  certificateMimeType String?
  certificateData     Bytes?
  fatherName          String
  fatherNidNumber     String
  fatherContactNumber String
  fatherOccupation    String
  fatherNationality   String
  fatherIsAlive       Boolean
  motherName          String
  motherNidNumber     String
  motherContactNumber String
  motherOccupation    String
  motherNationality   String
  motherIsAlive       Boolean
  assignedOfficer     User?               @relation("AssignedOfficer", fields: [assignedOfficerId], references: [id])
  cycle               AdmissionCycle      @relation(fields: [cycleId], references: [id])
  guardians           AdmissionGuardian[]
  reviews             AdmissionReview[]
}

model AdmissionGuardian {
  id            String               @id @default(cuid())
  applicationId String
  name          String
  relationship  String
  nidNumber     String
  contactNumber String
  occupation    String
  nationality   String
  isAlive       Boolean
  createdAt     DateTime             @default(now())
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model AdmissionReview {
  id               String               @id @default(cuid())
  applicationId    String
  officerId        String?
  internalNote     String
  applicantMessage String?
  statusAtReview   ApplicationStatus
  createdAt        DateTime             @default(now())
  application      AdmissionApplication @relation(fields: [applicationId], references: [id])
  officer          User?                @relation(fields: [officerId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  actorLabel String
  action     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  ADMISSION_OFFICER
  BLOGGER
  TEACHER
}

enum ApplicationStatus {
  UNASSIGNED
  ASSIGNED
  UNDER_REVIEW
  AWAITING_APPLICANT
  ELIGIBLE
  NOT_ELIGIBLE
  EXAM_ELIGIBLE
  EXAM_COMPLETED
  FINAL_DECISION
}


model HelpArticle {
  id          String   @id @default(cuid())
  slug        String   @unique
  questionEn  String
  questionBn  String
  answerEn    String   @db.Text
  answerBn    String   @db.Text
  categoryEn  String
  categoryBn  String
  isPublished Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
  @@index([categoryEn])
}


enum BloggerType {
  STUDENT
  TEACHER
}

enum BlogApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BlogArticleStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum BloggerNameChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

model BlogApplication {
  id                    String @id @default(cuid())
  type                  BloggerType
  status                BlogApplicationStatus @default(PENDING)
  fullName              String
  email                 String
  schoolId              String
  phone                 String?
  className             String?
  section               String?
  rollNumber            String?
  guardianName          String?
  guardianRelationship  String?
  guardianPhone         String?
  formTeacher           String?
  subject               String?
  reviewedById          String?
  reviewer              User? @relation("BlogApplicationReviewer", fields: [reviewedById], references: [id])
  reviewNote            String? @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@index([status, createdAt])
  @@index([schoolId, type])
}

model BloggerProfile {
  id             String @id @default(cuid())
  userId         String @unique
  type           BloggerType
  schoolId       String @unique
  phone          String?
  className      String?
  section        String?
  rollNumber     String?
  guardianName   String?
  guardianRelationship String?
  guardianPhone  String?
  formTeacher    String?
  subject        String?
  displayName    String
  photoUrl       String?
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  articles        BlogArticle[]
  nameChanges     BloggerNameChange[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BlogArticle {
  id             String @id @default(cuid())
  authorId       String
  title          String
  slug           String @unique
  excerpt        String? @db.Text
  content        String @db.Text
  featuredImage  String? @db.Text
  status         BlogArticleStatus @default(DRAFT)
  publishedAt    DateTime?
  viewCount      Int @default(0)
  author         BloggerProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([status, publishedAt])
  @@index([authorId, status])
}

model BloggerNameChange {
  id           String @id @default(cuid())
  profileId    String
  requestedName String
  status       BloggerNameChangeStatus @default(PENDING)
  reviewedById String?
  reviewNote   String? @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  profile      BloggerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reviewer     User? @relation("NameChangeReviewer", fields: [reviewedById], references: [id])
  @@index([status, createdAt])
}


model TeacherProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  staffId           String   @unique
  name              String
  designation       String
  wing              String   @default("Unassigned")
  subjects          String[] @default([])
  photoUrl          String?
  highestDegree     String?
  university        String?
  qualifications    String?  @db.Text
  quote             String?  @db.Text
  biography         String?  @db.Text
  studentMessage    String?  @db.Text
  isPublished       Boolean  @default(false)
  isActive          Boolean  @default(true)
  mustChangePassword Boolean @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([wing, designation])
  @@index([isPublished, isActive])
}
